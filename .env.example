# ==============================================================================
# AI Fashion Marketplace - Environment Configuration Template
# Copy this file to .env before starting the services
# NEVER commit the actual .env file with production secrets to version control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="AI Fashion Marketplace"
APP_VERSION="0.1.0"
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3001

# PostgreSQL + pgvector
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fashion_marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fashion_marketplace
POSTGRES_PORT=5432

# Redis Cache & State
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fashion-media
MINIO_USE_SSL=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# CORS Configuration (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# PayPal Sandbox Configuration (Backend)
# Never commit real credentials to version control.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="AI Fashion Marketplace"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
